{
  "name": "pikistreams",
  "version": "1.0.0",
  "description": "Fullstack PikiStreams Movie App",
  "scripts": {
    "start": "node backend/server.js",
    "server": "nodemon backend/server.js",
    "worker:start": "node backend/workers/bulk-worker.js --run",
    "worker:tv:start": "node backend/workers/bulk-tv-worker.js --run",
    "worker:torrentio:tv": "node backend/workers/torrentio-tv-worker.js --run",
    "feed:tv": "node backend/feed-tv.js",
    "stream": "nodemon backend/stream-server/index.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run stream\" \"npm run client\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "axios": "^1.21.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "crawlee": "^3.18.2",
    "dotenv": "^18.0.9",
    "express": "^4.18.2",
    "lru-cache": "^11.5.3",
    "playwright": "^1.64.1",
    "puppeteer": "^21.5.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-adblocker": "^2.13.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "webtorrent": "^3.0.21"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "nodemon": "^3.0.1"
  }
}
